# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API, and Project Settings -> Database).

# Safe to expose to the browser. Row-level security is what actually
# protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and never reach a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler connection string, used by the Supabase CLI to run
# migrations. Use the pooler rather than the direct db.<ref>.supabase.co
# host: direct connections are IPv6-only, which fails on IPv4-only networks.
SUPABASE_DB_URL=

# Entering this code during sign-up creates an organizer account. Keeps
# organizer access out of the database seed and out of the codebase.
ORGANIZER_SIGNUP_CODE=

# Reads applications for CalIntelligence. Server-only, runtime only.
ANTHROPIC_API_KEY=

# Optional, and worth setting. Raises the GitHub API rate limit from sixty
# requests an hour per IP address to five thousand. CalIntelligence spends
# eight requests per application, so sixty covers seven of them, and a deployment
# shares its address with everything else on the platform. It works without
# one — a repository that could not be read because of the limit says exactly
# that on the panel, rather than blaming the applicant — but the limit is
# reached quickly.
#
# It needs no scopes at all. A classic token with every box unticked, or a
# fine-grained token limited to public repositories and read-only access, is
# enough for public data and is the right amount of access to hand a web app.
GITHUB_TOKEN=
